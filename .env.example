APP_NAME=EchoVault Node Service
APP_ENV=development
HOST=0.0.0.0
PORT=8000
GRPC_HOST=localhost
GRPC_BIND_HOST=0.0.0.0
GRPC_PORT=50051
GRPC_TIMEOUT_SECONDS=5
DATABASE_URL=postgresql+asyncpg://username:password@host/database?sslmode=require
NODE_ID=node-dev-001
NODE_NAME=Development Node
NODE_TYPE=coordinator
NODE_HOST=localhost
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
FRONTEND_ORIGIN=http://localhost:3000
STORAGE_DIR=storage/evidence
MAX_UPLOAD_SIZE_MB=50

# ── RabbitMQ ──────────────────────────────────────────────────────────────────
# For local development, RabbitMQ runs via Docker Compose.
# Inside Docker containers use RABBITMQ_HOST=rabbitmq (service name).
# Outside Docker (local Python), use RABBITMQ_HOST=localhost.
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/
RABBITMQ_EXCHANGE=echovault.events
RABBITMQ_MESSAGE_TTL_SECONDS=86400
RABBITMQ_RETRY_LIMIT=3

# ── Peer-to-Peer Communication (Part 8) ───────────────────────────────────────
P2P_HOST=localhost
P2P_PORT=8000
P2P_RECONNECT_MAX_BACKOFF=30

# ── WebRTC Multimedia Streaming (Part 9) ──────────────────────────────────────
WEBRTC_STUN_SERVER=stun:stun.l.google.com:19302
MEDIA_MODE=demo
SUPPORTS_VIDEO=true
SUPPORTS_AUDIO=true
